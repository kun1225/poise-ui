{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "next-env.d.ts", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
