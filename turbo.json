{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@poise-ui/docs#build": {
      "dependsOn": ["^build", "@poise-ui/registry#registry"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "registry": {
      "dependsOn": ["^build"],
      "inputs": ["../packages/**/src/**"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
